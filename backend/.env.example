# Backend Environment Variables
# Copy this file to .env for local development
# In production, set these as environment variables in your deployment platform

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/onboarding_db   # 로컬 예시
DATABASE_USERNAME=postgres                                    # 예시
DATABASE_PASSWORD=changeme                                    # 반드시 변경

# JWT
JWT_SECRET=<YOUR_SECURE_JWT_SECRET>
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (Development - MailHog)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=<SENDER_EMAIL>

# Email URLs
EMAIL_VERIFICATION_URL=http://localhost:5173/auth/verify-email
EMAIL_PASSWORD_RESET_URL=http://localhost:5173/auth/reset-password

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# AWS S3 (Optional)
# AWS_S3_BUCKET_NAME=<YOUR_S3_BUCKET_NAME>
# AWS_S3_REGION=ap-northeast-2
# AWS_S3_ACCESS_KEY=<YOUR_AWS_ACCESS_KEY_ID>
# AWS_S3_SECRET_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
